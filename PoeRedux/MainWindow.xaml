<Window x:Class="PoeRedux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PoeRedux"
        Width="800" Height="580" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Compact header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PoeRedux" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="•" Foreground="{StaticResource TextDisabled}" Margin="9,0"/>
                <TextBlock x:Name="GameBadgeText" Text="PATH OF EXILE 2" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderSubtitleText" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateNotificationButton" Content="Update available" Visibility="Collapsed"
                        Margin="0,0,8,0" Style="{StaticResource CompactButton}" Click="UpdateNotificationButton_Click"/>
                <ComboBox x:Name="LanguageComboBox" Width="118" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Tag="en">English</ComboBoxItem>
                    <ComboBoxItem Tag="vi">Tiếng Việt</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- File and camera in one compact row -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GameFileTitleText" Text="Game file" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="GameFileDescriptionText" Visibility="Collapsed"/>
                <TextBox x:Name="GgpkPathTextBox" Grid.Column="1" TextChanged="GgpkPathTextBox_TextChanged"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse" Click="BrowseButton_Click" Style="{StaticResource CompactButton}" Margin="7,0,0,0" MinWidth="76"/>
                <TextBlock x:Name="CameraTitleText" Grid.Column="4" Text="Camera" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="CameraDescriptionText" Visibility="Collapsed"/>
                <Slider x:Name="ZoomSlider" Grid.Column="5" Minimum="1.2" Maximum="2.4" Value="2.4" TickFrequency="0.2"
                        IsSnapToTickEnabled="True" Style="{StaticResource RoundGreySlider}" ValueChanged="ZoomSlider_ValueChanged"/>
                <TextBlock x:Name="ZoomValueText" Grid.Column="6" Text="2.4×" Foreground="{StaticResource TextPrimary}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Patch toolbar -->
        <Grid Grid.Row="2" Margin="2,5,2,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PatchesTitleText" Text="Patches" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="•" Foreground="{StaticResource TextDisabled}" Margin="7,0"/>
                <TextBlock x:Name="PatchesSummaryText" Text="0 of 18 selected" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAllButton_Click" Style="{StaticResource CompactButton}" Margin="0,0,5,0"/>
                <Button x:Name="SelectNoneButton" Content="Clear" Click="SelectNoneButton_Click" Style="{StaticResource CompactButton}" Margin="0,0,5,0"/>
                <Button x:Name="ModsColorsButton" Content="Mod colors" Click="ModsColorsButton_Click" Style="{StaticResource CompactButton}" Margin="0,0,5,0"/>
                <Button x:Name="DeleteBackupButton" Content="Delete backup" Click="DeleteBackupButton_Click" IsEnabled="False" Style="{StaticResource CompactButton}"/>
            </StackPanel>
        </Grid>

        <!-- Grouped patch list -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
                <ItemsControl x:Name="PatchesItemsControl" Margin="-1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="9,12,0,5" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource PatchCardCheckBox}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" FontSize="9.5" LineHeight="12.5" MaxHeight="27" ClipToBounds="True"/>
                                    </StackPanel>
                                </CheckBox>
                                <Button Grid.Column="1" Content="⚙" Width="29" Height="29" Margin="0,6,5,0" VerticalAlignment="Top"
                                        Visibility="{Binding OptionsVisibility}" Click="PatchOptionsButton_Click"
                                        Style="{StaticResource CompactButton}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Compact footer -->
        <Grid Grid.Row="4" Margin="2,7,2,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabelText" Text="STATUS" Foreground="{StaticResource TextDisabled}" FontSize="8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Select a game file to begin." Foreground="{StaticResource TextPrimary}" FontSize="10.5" Margin="0,1,0,0"/>
                    <TextBlock x:Name="SafetyTitleText" Visibility="Collapsed"/>
                    <TextBlock x:Name="SafetyDescriptionText" Visibility="Collapsed"/>
                </StackPanel>
                <Button x:Name="RestoreButton" Grid.Column="1" Content="Restore original" Click="RestoreButton_Click"
                        MinWidth="126" Height="34" VerticalAlignment="Center" IsEnabled="False" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/>
                <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply patches" Click="ApplyButton_Click" MinWidth="142" Height="34" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="ProgressBar" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</Window>
