<Window x:Class="PoeRedux.ColorModsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map mod colors"
        Height="650" Width="760" MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,18">
            <TextBlock x:Name="EditorTitleText" Text="Map mod colors" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="EditorDescriptionText" Text="Choose which map modifiers to highlight and assign their colors."
                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="GroupsTitleText" Text="Color groups (#RRGGBB)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="3,0,0,8"/>
                <ItemsControl x:Name="ColorGroupsItemsControl">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox x:Name="TagPrefixCheckBox" Margin="4,10,4,0" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
                <ItemsControl x:Name="ColorModsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource AppBorder}"
                                    BorderThickness="1" Padding="13,10" Margin="3" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColor}"
                                              Style="{StaticResource DarkComboBox}" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveConfigButton" Content="Save config" MinWidth="110" Click="SaveConfigButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="LoadConfigButton" Content="Load config" MinWidth="110" Click="LoadConfigButton_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ExitButton" Content="Cancel" MinWidth="100" Click="ExitButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save" MinWidth="110" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
