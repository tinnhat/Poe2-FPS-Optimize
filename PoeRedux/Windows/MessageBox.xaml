<Window x:Class="PoeRedux.MessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoeRedux" Height="240" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Grid Margin="22">
        <Border Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentMuted}" Margin="0,0,12,0">
                        <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}" Margin="46,14,0,12">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextSecondary}"/>
                </ScrollViewer>
                <Button x:Name="OkButton" Grid.Row="2" Content="OK" MinWidth="92" Click="OkButton_Click" IsDefault="True" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
